---
import PbImage from "./PbImage.astro";
const { offre } = Astro.props;
---

<div
  class={"offre-card rounded-lg shadow-sm bg-white hover:shadow-md transition-all duration-300 overflow-hidden border border-[#D4C5B0] hover:border-[#3E2723] group " + (offre.Favori ? 'ring-2 ring-[#3E2723]' : '')}
  data-favori={offre.Favori}
>
  <div class="flex flex-row h-[280px]">
    <div class="w-[30%] relative overflow-hidden flex-shrink-0">
     <button class="favoriteButton absolute bottom-0 left-0 p-2 text-white rounded-br-lg" data-offre={JSON.stringify(offre)}>
    <img id="favorite-icon" src={offre.Favori ? "favorite_filled.png" : "favorite.png"} alt="Favorite Icon" class="w-6 h-6" />
</button>
        <img
          src="/src/assets/favorite.png"
          alt="Favori"
          class={offre.Favori ? 'w-10 h-10 opacity-100' : 'w-10 h-10 opacity-40'}
          style="object-fit: cover; object-position: center; display: block; margin: auto; padding: 2px;"
        />
      </button>
      <div class="w-full h-full transform transition-transform duration-500 group-hover:scale-110">
        {offre.image && (
          <PbImage record={offre} recordImage={Array.isArray(offre.image) ? offre.image[0] : offre.image} width={400} height={400} />
        )}
      </div>
    </div>
    
    <div class="w-[70%] p-6 flex flex-col justify-between">
      <div>
        <h3 class="font-bold text-2xl text-[#3E2723] mb-2">{offre.Nom_maison}</h3>
        
        <p class="text-sm text-[#3E2723] opacity-70 mb-4">📍 {offre.Adresse}</p>
        
        <div class="flex gap-4 mb-4 text-sm text-[#3E2723]">
          <div class="flex items-center gap-1.5">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
            </svg>
            <span class="font-medium">{offre.Surface} m²</span>
          </div>
        </div>
      </div>
      
      <div class="flex items-end justify-between">
        <div class="text-3xl font-bold text-[#3E2723]">{offre.Prix?.toLocaleString('fr-FR')} €</div>
        <a 
          href={`/offres/${offre.id}`} 
          class="bg-[#3E2723] hover:bg-[#5D4037] text-[#FAF8F3] px-5 py-2.5 rounded-md font-semibold transition text-sm"
        >
          Voir plus →
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  //@ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    const favoriteButtons = document.querySelectorAll(".favoriteButton");
    favoriteButtons.forEach(button => {
      button.addEventListener('click', async () => {
        const offreData = JSON.parse(button.dataset.offre || '{}');
        const newFavori = !offreData.Favori;

        await fetch(`/api/favori?id=${offreData.id}&favori=${newFavori}`, { method: 'POST' });

        const favIcon = button.querySelector('#favorite-icon');
        if (favIcon) {
          favIcon.style.opacity = newFavori ? "1" : "0.4";
        }
        offreData.Favori = newFavori;
        button.dataset.offre = JSON.stringify(offreData);
      });
    });
  });
</script>
